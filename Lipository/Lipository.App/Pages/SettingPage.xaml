<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lipository.App.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lipository.App.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Height="650">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,5,5">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="160"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- 전체 테두리 -->
                <Border Grid.Row="0" Grid.RowSpan="13" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="1" />

                <!-- 가로 구분선 (행 0~11의 아래쪽 경계, 총 12개) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />
                <Border Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="7" BorderBrush="Gray" BorderThickness="0,0,0,1" />

                <!-- 세로 구분선 (열 0~5의 오른쪽 경계, 총 6개) -->
                <Border Grid.Row="0" Grid.RowSpan="13" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0" />
                <Border Grid.Row="0" Grid.RowSpan="13" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,0" />
                <Border Grid.Row="0" Grid.RowSpan="13" Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,1,0" />
                <Border Grid.Row="0" Grid.RowSpan="13" Grid.Column="3" BorderBrush="Gray" BorderThickness="0,0,1,0" />
                <Border Grid.Row="0" Grid.RowSpan="13" Grid.Column="4" BorderBrush="Gray" BorderThickness="0,0,1,0" />
                <Border Grid.Row="0" Grid.RowSpan="13" Grid.Column="5" BorderBrush="Gray" BorderThickness="0,0,1,0" />

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Visible" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Text" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="X Position" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Y Position" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="5" Text="Width" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Height" HorizontalTextAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Main Item" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <NumberBox Grid.Row="1" Grid.Column="5" Value="{x:Bind ViewModel.SettingsData.TotalInfo.Width, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="1" Grid.Column="6" Value="{x:Bind ViewModel.SettingsData.TotalInfo.Height, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Image" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.ImageInfo.IsVisible, Mode=OneWay}" />
                <NumberBox Grid.Row="2" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.ImageInfo.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="2" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.ImageInfo.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="2" Grid.Column="5" Value="{x:Bind ViewModel.SettingsData.ImageInfo.Width, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="2" Grid.Column="6" Value="{x:Bind ViewModel.SettingsData.ImageInfo.Height, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Title" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.TitleInfo.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.TitleInfo.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="3" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.TitleInfo.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="3" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.TitleInfo.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Subtitle" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.SubTitleInfo.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="4" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.SubTitleInfo.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="4" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.SubTitleInfo.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="4" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.SubTitleInfo.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Rate" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.RateInfo.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="5" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.RateInfo.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="5" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.RateInfo.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="5" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.RateInfo.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="ETC1" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.Etc1Info.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="6" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.Etc1Info.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="6" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.Etc1Info.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="6" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.Etc1Info.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="ETC2" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="7" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.Etc2Info.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="7" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.Etc2Info.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="7" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.Etc2Info.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="7" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.Etc2Info.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="ETC3" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="8" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.Etc3Info.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="8" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.Etc3Info.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="8" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.Etc3Info.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="8" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.Etc3Info.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="9" Grid.Column="0" Text="ETC4" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="9" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.Etc4Info.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="9" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.Etc4Info.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="9" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.Etc4Info.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="9" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.Etc4Info.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Memo" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="10" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.MemoInfo.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="10" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.MemoInfo.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="10" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.MemoInfo.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="10" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.MemoInfo.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Release" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="11" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.ReleaseDateInfo.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="11" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.ReleaseDateInfo.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="11" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.ReleaseDateInfo.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="11" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.ReleaseDateInfo.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

                <TextBlock Grid.Row="12" Grid.Column="0" Text="Lastest" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                <CheckBox Grid.Row="12" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                          IsChecked="{x:Bind ViewModel.SettingsData.LastDateInfo.IsVisible, Mode=OneWay}" />
                <TextBox Grid.Row="12" Grid.Column="2" Text="{x:Bind ViewModel.SettingsData.LastDateInfo.Text, Mode=OneWay}" />
                <NumberBox Grid.Row="12" Grid.Column="3" Value="{x:Bind ViewModel.SettingsData.LastDateInfo.XPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
                <NumberBox Grid.Row="12" Grid.Column="4" Value="{x:Bind ViewModel.SettingsData.LastDateInfo.YPos, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />

            </Grid>

            <StackPanel Grid.Row="1" Margin="5,0,0,0">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Video Extensions" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SettingsData.MediaExtensions, Mode=OneWay}" />
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Image Extensions" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SettingsData.ImageExtensions, Mode=OneWay}" />
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Default Image Path" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SettingsData.DefaultImagePath, Mode=OneWay}" />
                </Grid>
            </StackPanel>
            <Button Grid.Row="2" Content="Save" HorizontalAlignment="Right" Command="{x:Bind ViewModel.SaveCommand}" />
        </Grid>

        <Grid Grid.Column="1" Margin="5,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Preview" FontSize="16" />
        </Grid>
    </Grid>
    
</Page>
