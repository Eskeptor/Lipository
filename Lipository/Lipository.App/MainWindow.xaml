<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lipository.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lipository.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:globals="using:Lipository.App.Globals"
    mc:Ignorable="d"
    Title="Lipository.App">

    <!--<Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>-->
    <NavigationView x:Name="nvMain" Header="This is My Header" PaneDisplayMode="Left"
                    SelectionChanged="NvMain_SelectionChanged" IsSettingsVisible="True">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Main" Tag="MainPage" Icon="Library" />
            <NavigationViewItem Content="Menu2" Tag="Page2" Icon="Map" />
            <NavigationViewItem Content="Menu3" Tag="Page3" Icon="Tag" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="DB" Tag="DatabasePage" Icon="Sync" />
        </NavigationView.FooterMenuItems>

        <Frame x:Name="mainFrame" Margin="0,0,0,0" />
    </NavigationView>

    
</Window>
